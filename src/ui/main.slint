import { LineEdit, ScrollView } from "std-widgets.slint";

export enum AppState {
    Welcome,
    DeckSelect,
    Reviewing,
    Summary,
    Settings,
    ManageDecks,
}

export struct ManageDeck {
    name: string,
    selected: bool,
    hidden: bool,
}

export struct DeckInfo {
    name: string,
    counts_text: string,
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked;
    height: 44px;
    min-width: 120px;
    border-radius: 10px;
    border-width: primary ? 2px : 1px;
    border-color: primary ? #FFFFFF : #888888;
    background: primary ? #FFFFFF : #000000;
    horizontal-stretch: 1;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: primary ? #000000 : #FFFFFF;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SmallButton inherits Rectangle {
    in property <string> label;
    callback clicked;
    width: 72px;
    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #888888;
    background: #000000;
    TouchArea { clicked => { root.clicked(); } }
    Text { text: root.label; color: #BBBBBB; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
}

component LimitButton inherits Rectangle {
    in property <int> value: 10;
    in property <string> label: "10";
    in property <int> current: 10;
    callback picked(int);
    horizontal-stretch: 1;
    height: 40px;
    border-radius: 8px;
    border-width: current == value ? 2px : 1px;
    border-color: current == value ? #FFFFFF : #666666;
    background: #000000;
    TouchArea { clicked => { root.picked(root.value); } }
    Text { text: root.label; color: #FFFFFF; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
}

// A yojijukugo: bold kanji, reading, then the English meaning underneath.
component MottoBlock inherits VerticalLayout {
    in property <string> kanji;
    in property <string> romaji: "";
    in property <string> meaning: "";
    in property <length> kanji_size: 22px;
    alignment: center;
    spacing: 2px;
    Text {
        text: root.kanji;
        color: #FFFFFF;
        font-size: root.kanji_size;
        horizontal-alignment: center;
    }
    if (root.romaji != "") : Text {
        text: root.romaji;
        color: #888888;
        font-size: 12px;
        horizontal-alignment: center;
    }
    if (root.meaning != "") : Text {
        text: root.meaning;
        color: #666666;
        font-size: 11px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

export component AppWindow inherits Window {
    title: "Shizuka";
    background: #000000;
    preferred-width: 420px;
    preferred-height: 760px;
    min-width: 360px;
    min-height: 600px;

    in-out property <string> card_front: "";
    in-out property <string> card_back: "";
    in-out property <string> card_reading: "";
    in-out property <string> card_notes: "";
    in-out property <string> card_speak_text: "";
    in-out property <AppState> current_state: AppState.Welcome;
    in-out property <bool> is_revealed: false;
    in-out property <string> selected_deck: "";
    in-out property <int> current_card_id: 0;
    in-out property <[DeckInfo]> deck_infos: [];
    in-out property <[ManageDeck]> manage_decks: [];
    in-out property <string> status_message: "";
    in-out property <string> import_path: "";
    in-out property <string> import_deck_name: "";
    in-out property <string> card_direction: "random";
    in-out property <int> new_card_limit: 10;
    in-out property <string> interval_bad: "1d";
    in-out property <string> interval_ok: "1d";
    in-out property <string> interval_good: "1d";
    in-out property <string> interval_easy: "1d";
    in-out property <string> session_progress: "";
    in-out property <string> summary_title: "Session complete";
    in-out property <string> summary_stats: "";
    // Yojijukugo shown to the learner: kanji / romaji / English meaning.
    // motto_* is the app-wide phrase (main menu + top strip); summary_* is
    // picked per session by Rust.
    in-out property <string> motto_kanji: "";
    in-out property <string> motto_romaji: "";
    in-out property <string> motto_meaning: "";
    in-out property <string> summary_motto_kanji: "";
    in-out property <string> summary_motto_romaji: "";
    in-out property <string> summary_motto_meaning: "";
    in-out property <[string]> recap_words: [];
    in-out property <string> streak_text: "No streak yet";
    in-out property <string> today_text: "0 / 15 min today";
    in-out property <string> today_goal_text: "0/15 min"; // For goal widget
    in-out property <float> today_progress: 0.0; // 0.0-1.0 for goal progress bar
    in property <bool> is_mobile: false;
    // Set from Rust: a Japanese-capable font so kanji never fall back to tofu.
    in-out property <string> ui_font_family: "";
    default-font-family: root.ui_font_family;


    callback open_deck_select();
    callback select_deck(string);
    callback change_deck();
    callback reveal_card();
    callback rate_card(int);
    callback keep_learning();
    callback end_session();

    callback open_settings();
    callback open_manage();
    callback set_card_direction(string);
    callback set_new_card_limit(int);
    callback toggle_manage_deck(int);
    callback bulk_export();
    callback bulk_hide();
    callback bulk_unhide();
    callback import_path_deck(string);
    callback import_folder();
    callback import_clipboard();
    callback backup_database();

    // Keyboard shortcuts (Mac): 1-4 rate, Space reveal
    forward-focus: key-handler;
    key-handler := FocusScope {
        x: 0; y: 0;
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (root.current_state != AppState.Reviewing) { return reject; }
            if (event.text == " " && !root.is_revealed) {
                root.reveal_card();
                return accept;
            }
            if (root.is_revealed) {
                if (event.text == "1") { root.rate_card(0); return accept; }
                if (event.text == "2") { root.rate_card(1); return accept; }
                if (event.text == "3") { root.rate_card(2); return accept; }
                if (event.text == "4") { root.rate_card(3); return accept; }
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding-left: 24px + root.safe-area-insets.left;
            padding-right: 24px + root.safe-area-insets.right;
            padding-top: 24px + root.safe-area-insets.top;
            padding-bottom: 24px + root.safe-area-insets.bottom;
            spacing: 16px;

            // The app's motto rides at the top of every working screen
            // ("fall seven times, stand up eight times" — a missed card is a
            // step, not a failure).
            if (root.current_state != AppState.Welcome && root.current_state != AppState.Summary && root.motto_kanji != "") : HorizontalLayout {
                width: 100%;
                alignment: center;
                Text {
                    text: root.motto_kanji + " · " + root.motto_romaji;
                    color: #555555;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
            }

            // WELCOME
            if (root.current_state == AppState.Welcome) : VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 20px;
                HorizontalLayout { alignment: center; Text { text: "SHIZUKA"; color: #FFFFFF; font-size: 34px; } }
                HorizontalLayout { alignment: center; Text { text: "Japanese flashcards"; color: #888888; font-size: 16px; } }
                if (root.motto_kanji != "") : HorizontalLayout {
                    alignment: center;
                    MottoBlock {
                        width: min(340px, root.width - 48px);
                        kanji: root.motto_kanji;
                        romaji: root.motto_romaji;
                        meaning: root.motto_meaning;
                        kanji_size: 26px;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: min(320px, root.width - 48px);
                        spacing: 4px;
                        Text { text: root.streak_text; color: #FFFFFF; font-size: 15px; horizontal-alignment: center; }
                        Text { text: root.today_text; color: #666666; font-size: 12px; horizontal-alignment: center; }
                    }
                }
                Rectangle { height: 12px; }
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: min(320px, root.width - 48px);
                        spacing: 12px;
                        ActionButton { label: "Study"; primary: true; clicked => { root.open_deck_select(); } }
                        ActionButton { label: "Settings"; clicked => { root.open_settings(); } }
                    }
                }
            }

            // DECK SELECT
            if (root.current_state == AppState.DeckSelect) : VerticalLayout {
                width: 100%;
                vertical-stretch: 1;
                spacing: 14px;
                alignment: center;
                HorizontalLayout { width: 100%; alignment: center; Text { text: "Choose a deck"; color: #FFFFFF; font-size: 24px; } }
                if (root.deck_infos.length == 0) : HorizontalLayout {
                    width: 100%; vertical-stretch: 1; alignment: center;
                    Text { text: "No visible decks.\nOpen Settings > Manage decks."; color: #888888; font-size: 14px; horizontal-alignment: center; }
                }
                if (root.deck_infos.length > 0) : VerticalLayout {
                    width: 100%;
                    vertical-stretch: 1;
                    alignment: start;
                    spacing: 10px;
                    for info in root.deck_infos : HorizontalLayout {
                        width: 100%;
                        alignment: center;
                        Rectangle {
                            width: min(360px, root.width - 48px);
                            height: 56px;
                            border-radius: 12px;
                            border-width: 1px; border-color: #FFFFFF; background: #000000;
                            TouchArea { clicked => { root.select_deck(info.name); } }
                            VerticalLayout {
                                alignment: center;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 2px;
                                Text { text: info.name; color: #FFFFFF; font-size: 16px; horizontal-alignment: center; overflow: elide; }
                                Text { text: info.counts_text; color: #888888; font-size: 11px; horizontal-alignment: center; }
                            }
                        }
                    }
                }
                if (root.status_message != "") : HorizontalLayout {
                    width: 100%; alignment: center;
                    Text { width: min(360px, root.width - 48px); text: root.status_message; color: #888888; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                }
                HorizontalLayout {
                    width: 100%;
                    alignment: center;
                    HorizontalLayout {
                        width: min(360px, root.width - 48px);
                        spacing: 12px;
                        ActionButton { label: "Back"; clicked => { root.current_state = AppState.Welcome; } }
                        ActionButton { label: "Settings"; clicked => { root.open_settings(); } }
                    }
                }
            }

            // SETTINGS
            if (root.current_state == AppState.Settings) : VerticalLayout {
                vertical-stretch: 1;
                spacing: 14px;
                HorizontalLayout { alignment: center; Text { text: "Settings"; color: #FFFFFF; font-size: 24px; } }

                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: min(360px, root.width - 48px);
                        spacing: 10px;
                        Text { text: "Card direction"; color: #888888; font-size: 13px; }
                        for mode in ["character", "pronunciation", "random"] : Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            border-width: root.card_direction == mode ? 2px : 1px;
                            border-color: root.card_direction == mode ? #FFFFFF : #666666;
                            background: #000000;
                            TouchArea { clicked => { root.set_card_direction(mode); } }
                            Text {
                                text: mode == "character" ? "Front first" : (mode == "pronunciation" ? "Back first" : "Random");
                                color: #FFFFFF; font-size: 15px; horizontal-alignment: center; vertical-alignment: center;
                            }
                        }

                        Rectangle { height: 6px; }
                        Text { text: "New cards per day"; color: #AAAAAA; font-size: 13px; }
                        HorizontalLayout {
                            spacing: 8px;
                            LimitButton { value: 5; label: "5"; current: root.new_card_limit; picked(v) => { root.set_new_card_limit(v); } }
                            LimitButton { value: 10; label: "10"; current: root.new_card_limit; picked(v) => { root.set_new_card_limit(v); } }
                            LimitButton { value: 20; label: "20"; current: root.new_card_limit; picked(v) => { root.set_new_card_limit(v); } }
                            LimitButton { value: 40; label: "40"; current: root.new_card_limit; picked(v) => { root.set_new_card_limit(v); } }
                        }

                        Rectangle { height: 6px; }
                        ActionButton { label: "Manage decks (export/import/hide)"; clicked => { root.open_manage(); } }
                        ActionButton { label: "Back up database"; clicked => { root.backup_database(); } }
                    }
                }

                if (root.status_message != "") : HorizontalLayout {
                    alignment: center;
                    Text { text: root.status_message; color: #888888; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: center;
                    HorizontalLayout {
                        width: min(360px, root.width - 48px);
                        ActionButton { label: "Back"; clicked => { root.open_deck_select(); } }
                    }
                }
            }

            // MANAGE DECKS (under Settings)
            if (root.current_state == AppState.ManageDecks) : VerticalLayout {
                width: 100%;
                vertical-stretch: 1;
                spacing: 10px;
                alignment: start;
                HorizontalLayout { width: 100%; alignment: center; Text { text: "Manage decks"; color: #FFFFFF; font-size: 22px; } }

                HorizontalLayout {
                    width: 100%;
                    alignment: center;
                    VerticalLayout {
                        width: min(360px, root.width - 48px);
                        spacing: 8px;
                        Text { text: "Import CSV: front,back,reading,notes (reading/notes optional)"; color: #888888; font-size: 12px; wrap: word-wrap; }
                        LineEdit { placeholder-text: "Deck name (optional)"; text <=> root.import_deck_name; }
                        if (!root.is_mobile) : VerticalLayout {
                            spacing: 8px;
                            LineEdit { placeholder-text: "/path/to/deck.csv"; text <=> root.import_path; }
                            HorizontalLayout {
                                spacing: 10px;
                                ActionButton { label: "Import path"; clicked => { root.import_path_deck(root.import_path); } }
                                ActionButton { label: "Import clipboard"; clicked => { root.import_clipboard(); } }
                            }
                            ActionButton { label: "Import folder"; clicked => { root.import_folder(); } }
                            Text { text: "Import folder: <db dir>/import/*.csv"; color: #666666; font-size: 11px; wrap: word-wrap; }
                        }
                        if (root.is_mobile) : VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Copy CSV text, then tap Import clipboard.\nYou can also put .csv files in Files app → On My iPhone → Shizuka → import.";
                                color: #888888;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            ActionButton { label: "Import clipboard"; clicked => { root.import_clipboard(); } }
                            ActionButton { label: "Import folder"; clicked => { root.import_folder(); } }
                        }
                    }
                }

                HorizontalLayout {
                    width: 100%;
                    alignment: center;
                    VerticalLayout {
                        width: min(360px, root.width - 48px);
                        spacing: 6px;
                        vertical-stretch: 1;
                        Text { text: "Select decks, then export/hide/show"; color: #888888; font-size: 12px; }
                        for deck[idx] in root.manage_decks : Rectangle {
                            height: 38px;
                            border-radius: 8px;
                            border-width: deck.selected ? 3px : 1px;
                            border-color: deck.selected ? #FFFFFF : #555555;
                            background: #000000;
                            TouchArea { clicked => { root.toggle_manage_deck(idx); } }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    text: deck.hidden ? deck.name + " (hidden)" : deck.name;
                                    color: deck.hidden ? #777777 : #FFFFFF;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                if (deck.selected) : Text { text: "✓"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    width: 100%;
                    alignment: center;
                    HorizontalLayout {
                        width: min(360px, root.width - 48px);
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1; height: 44px;
                            border-width: 1px; border-color: #888888; background: #000000;
                            TouchArea { clicked => { root.bulk_export(); } }
                            Text { text: "Export"; color: #BBBBBB; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1; height: 44px;
                            border-width: 1px; border-color: #888888; background: #000000;
                            TouchArea { clicked => { root.bulk_hide(); } }
                            Text { text: "Hide"; color: #BBBBBB; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1; height: 44px;
                            border-width: 1px; border-color: #888888; background: #000000;
                            TouchArea { clicked => { root.bulk_unhide(); } }
                            Text { text: "Show"; color: #BBBBBB; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                if (root.status_message != "") : HorizontalLayout {
                    width: 100%; alignment: center;
                    Text { width: min(360px, root.width - 48px); text: root.status_message; color: #888888; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                }
                HorizontalLayout {
                    width: 100%;
                    alignment: center;
                    HorizontalLayout {
                        width: min(360px, root.width - 48px);
                        ActionButton { label: "Back to Settings"; clicked => { root.open_settings(); } }
                    }
                }
            }

            // REVIEWING
            if (root.current_state == AppState.Reviewing) : VerticalLayout {
                width: 100%;
                vertical-stretch: 1;
                spacing: 14px;

                HorizontalLayout {
                    width: 100%;
                    alignment: center;
                    HorizontalLayout {
                        width: min(360px, root.width - 48px);
                        alignment: space-between;
                        SmallButton { label: "Decks"; clicked => { root.change_deck(); } }
                        Text { text: root.session_progress; color: #888888; font-size: 12px; vertical-alignment: center; }
                        Text { text: root.selected_deck; color: #888888; font-size: 12px; vertical-alignment: center; overflow: elide; }
                    }
                }

                HorizontalLayout {
                    width: 100%;
                    vertical-stretch: 1;
                    alignment: center;
                    Rectangle {
                        width: min(360px, root.width - 48px);
                        height: 100%;
                        min-height: 180px;
                        max-height: 340px;
                        border-radius: 16px;
                        border-width: 2px; border-color: #FFFFFF; background: #000000;
                        VerticalLayout {
                            alignment: center;
                            padding: 16px;
                            spacing: 12px;
                            Text { text: root.card_front; color: #FFFFFF; font-size: 46px; horizontal-alignment: center; wrap: word-wrap; }
                            if (root.is_revealed && root.card_reading != "") : Text { text: root.card_reading; color: #999999; font-size: 16px; horizontal-alignment: center; wrap: word-wrap; }
                            if (root.is_revealed) : Text { text: root.card_back; color: #FFFFFF; font-size: 22px; horizontal-alignment: center; wrap: word-wrap; }
                            if (root.is_revealed && root.card_notes != "") : Text { text: root.card_notes; color: #888888; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                            if (!root.is_revealed) : Text { text: "Space / tap to reveal"; color: #555555; font-size: 12px; horizontal-alignment: center; }
                        }
                        if (!root.is_revealed) : TouchArea { clicked => { root.reveal_card(); } }
                    }
                }

                // Speak button removed


                if (root.is_revealed) : HorizontalLayout {
                    width: 100%;
                    alignment: center;
                    HorizontalLayout {
                        width: min(360px, root.width - 48px);
                        spacing: 8px;
                        for i in [0, 1, 2, 3] : Rectangle {
                            horizontal-stretch: 1;
                            height: 52px;
                            border-radius: 10px;
                            border-width: 1px; border-color: #FFFFFF; background: #000000;
                            TouchArea { clicked => { root.rate_card(i); } }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: i == 0 ? "Again" : (i == 1 ? "Hard" : (i == 2 ? "Good" : "Easy"));
                                    color: #FFFFFF; font-size: 13px; horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
                if (!root.is_revealed) : HorizontalLayout { width: 100%; height: 52px; }
            }

            // SESSION SUMMARY
            if (root.current_state == AppState.Summary) : VerticalLayout {
                width: 100%;
                vertical-stretch: 1;
                spacing: 14px;
                alignment: center;

                HorizontalLayout { width: 100%; alignment: center; Text { text: root.summary_title; color: #FFFFFF; font-size: 24px; } }
                HorizontalLayout { width: 100%; alignment: center; Text { text: root.summary_stats; color: #BBBBBB; font-size: 14px; horizontal-alignment: center; } }
                if (root.summary_motto_kanji != "") : HorizontalLayout {
                    width: 100%;
                    alignment: center;
                    MottoBlock {
                        width: min(360px, root.width - 48px);
                        kanji: root.summary_motto_kanji;
                        romaji: root.summary_motto_romaji;
                        meaning: root.summary_motto_meaning;
                    }
                }

                if (root.recap_words.length > 0) : VerticalLayout {
                    width: 100%;
                    vertical-stretch: 1;
                    spacing: 6px;
                    Text { text: "Worth another look"; color: #888888; font-size: 12px; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for word in root.recap_words : Rectangle {
                                width: min(360px, root.width - 48px);
                                height: 36px;
                                border-width: 1px; border-color: #555555; background: #000000;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    Text {
                                        text: word;
                                        color: #FFFFFF;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
                if (root.recap_words.length == 0) : HorizontalLayout {
                    width: 100%; vertical-stretch: 1; alignment: center;
                    Text { text: "Nothing missed. Nice work."; color: #888888; font-size: 14px; }
                }

                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: min(360px, root.width - 48px);
                        spacing: 12px;
                        ActionButton { label: "Keep learning"; primary: true; clicked => { root.keep_learning(); } }
                        ActionButton { label: "Back to decks"; clicked => { root.end_session(); } }
                    }
                }
            }
        }
    }
}
